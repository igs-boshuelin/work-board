# ⛔ 機密：Telegram botToken、管理密碼都在這裡。永遠不要進 repo。
#    要複製環境請用 config.example.json。
config.json

# ⛔ 登入憑證（密碼雜湊）
auth.json

# 實際工單資料（含同事姓名／工作內容），不是程式的一部分
data.json
backup/

# 暫存實驗（裡面另有一份帶真 token 的 config.json）
scratchpad/

# 執行時產生
server-out.log
server-err.log
node_modules/

# ⛔⛔ 加密備份的金鑰。進了 repo 等於備份沒加密。
#     遺失＝雲端備份永遠解不開，所以要另外抄一份到密碼管理器。
vault.key

# backup-vault.js restore 解出來的地方（就是三個機密檔的明文）
restored/

# 排程器每次備份的紀錄（純執行紀錄，不含機密，但也沒必要進版控）
backup-vault.log
